# Unified tool for syncing members and files between IBM i and local development environment

set -o pipefail

# Find the library directory (could be in same location as script or in install prefix)
SCRIPT_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
LIB_DIR="$SCRIPT_DIR/lib"

# If libs aren't in same directory, check install prefix
if [ ! -d "$LIB_DIR" ]; then
    # Check ~/.local/bin/ibmi-sync/lib (standard installation location)
    LIB_DIR="${HOME}/.local/bin/ibmi-sync/lib"
fi

# If still not found, try relative path
if [ ! -d "$LIB_DIR" ]; then
    LIB_DIR="$(dirname "$SCRIPT_DIR")/lib"
fi
VERSION="1.0.0"

# Source all libraries
source "$LIB_DIR/common.sh"
source "$LIB_DIR/config.sh"
source "$LIB_DIR/session.sh"
source "$LIB_DIR/members.sh"
source "$LIB_DIR/files.sh"
source "$LIB_DIR/git.sh"

# ============================================================================
# Help and Version
# ============================================================================

show_help() {
    cat << EOF
IBM i Unified Sync Tool v$VERSION

USAGE:
  ibmi-sync [command] [options]
  isync [command] [options]                    (shorthand)

COMMANDS:
  # No arguments - interactive menu
  ibmi-sync

  # Member operations
  member pull <member>              Pull member from IBM i
  member push <member>              Push member to IBM i (auto-creates if needed)
  member sync <member>              Push and compile member
  member compile <member>           Compile member on IBM i
  member create <member> [srctype]  Create new member (auto-detects from file extension)
  member list                       List all members
  member pull-all                   Pull all members
  member info <member>              Show member information
  member search <pattern>           Search for members
  member compare <member>           Compare local vs remote
  member delete <member>            Delete member

  # File operations
  file pull <remote> [local]        Pull file from IBM i
  file push <local> <remote>        Push file to IBM i
  file list [remote]                List remote directory

  # Folder operations
  folder pull <remote> [local]      Pull folder from IBM i
  folder push <local> <remote>      Push folder to IBM i
  folder sync <local> <remote>      Sync folder (bidirectional)

  # Git operations
  git init                          Initialize Git repository
  git status                        Show Git status
  git commit <message>              Commit changes
  git push [branch]                 Push to remote
  git pull [branch]                 Pull from remote
  git log [count]                   Show commit history
  git diff [file]                   Show changes

  # Session management
  session start                     Start SSH session
  session status [profile]          Show session status
  session stop [profile]            Stop SSH session
  session stop-all                  Stop all sessions
  session set [--library=LIB] [--srcfile=FILE]
                                    Set library/srcfile context for session
  session show                      Show current session context

  # Profile management
  profile list                      List all profiles
  profile create                    Create new profile
  profile switch <name>             Switch to profile
  profile edit <name>               Edit profile
  profile delete <name>             Delete profile
  profile test <name>               Test connection

  # Configuration
  config init                       Initialize configuration
  config edit                       Edit configuration file
  config show                       Show configuration
  config validate                   Validate configuration

  # Other
  help, --help, -h                  Show this help
  version, --version                Show version
  workflow <subcommand>             Run workflow commands

OPTIONS:
  --profile=NAME                    Use specific profile
  --library=LIB                     Override library for member commands
  --srcfile=FILE                    Override source file for member commands
  --verbose                         Detailed output
  --quiet                           Minimal output
  --debug                           Enable debug mode
  --dry-run                         Show what would be done
  --no-color                        Disable colored output

EXAMPLES:
  # Interactive menu
  ibmi-sync

  # Pull a member
  ibmi-sync member pull <Member>

  # Push and compile
  ibmi-sync member sync <Member> --profile=production

  # Pull member from different library/srcfile (one-time)
  ibmi-sync member pull <Member> --library=<TestLibrary> --srcfile=<CLLESourceFile>

  # Change session context (persistent until session ends)
  ibmi-sync session set --library=<TestLibrary> --srcfile=<CLLESourceFile>
  ibmi-sync member pull <Member>

  # Show current session context
  ibmi-sync session show

  # Pull a folder
  ibmi-sync folder pull /home/user/myapp myapp

  # Git commit and push
  ibmi-sync git commit "Updated files" && ibmi-sync git push

DOCUMENTATION:
  Full documentation: https://github.com/msasikumar/IBMi_Tools
  Issues: https://github.com/msasikumar/IBMi_Tools/issues


EOF
}

show_version() {
    echo "IBM i Unified Sync Tool v$VERSION"
}

# ============================================================================
# Argument Parsing
# ============================================================================

# Parse global options
parse_global_options() {
    while [[ $# -gt 0 ]]; do
        case "$1" in
            --profile=*)
                IBMI_PROFILE="${1#*=}"
                shift
                ;;
            --library=*)
                IBMI_OVERRIDE_LIBRARY="${1#*=}"
                shift
                ;;
            --srcfile=*)
                IBMI_OVERRIDE_SRCFILE="${1#*=}"
                shift
                ;;
            --verbose)
                IBMI_VERBOSE=1
                shift
                ;;
            --quiet)
                IBMI_QUIET=1
                shift
                ;;
            --debug)
                IBMI_DEBUG=1
                shift
                ;;
            --dry-run)
                IBMI_DRY_RUN=1
                shift
                ;;
            --no-color)
                IBMI_NO_COLOR=1
                shift
                ;;
            *)
                break
                ;;
        esac
    done
}

# ============================================================================
# Command Handlers
# ============================================================================

cmd_member() {
    local action=$1
    shift

    case "$action" in
        pull)
            [ $# -lt 1 ] && die "Member name required"
            member_pull "${IBMI_PROFILE:-$(get_current_profile)}" "$1"
            ;;
        push)
            [ $# -lt 1 ] && die "Member name required"
            member_push "${IBMI_PROFILE:-$(get_current_profile)}" "$1"
            ;;
        sync)
            [ $# -lt 1 ] && die "Member name required"
            member_sync "${IBMI_PROFILE:-$(get_current_profile)}" "$1"
            ;;
        compile)
            [ $# -lt 1 ] && die "Member name required"
            member_compile "${IBMI_PROFILE:-$(get_current_profile)}" "$1"
            ;;
        create)
            [ $# -lt 1 ] && die "Member name required"
            member_create "${IBMI_PROFILE:-$(get_current_profile)}" "$1" "${2:-TXT}"
            ;;
        list)
            member_list "${IBMI_PROFILE:-$(get_current_profile)}"
            ;;
        pull-all)
            member_pull_all "${IBMI_PROFILE:-$(get_current_profile)}"
            ;;
        info)
            [ $# -lt 1 ] && die "Member name required"
            member_info "${IBMI_PROFILE:-$(get_current_profile)}" "$1"
            ;;
        search)
            [ $# -lt 1 ] && die "Search pattern required"
            member_search "${IBMI_PROFILE:-$(get_current_profile)}" "$1"
            ;;
        compare)
            [ $# -lt 1 ] && die "Member name required"
            member_compare "${IBMI_PROFILE:-$(get_current_profile)}" "$1"
            ;;
        delete)
            [ $# -lt 1 ] && die "Member name required"
            member_delete "${IBMI_PROFILE:-$(get_current_profile)}" "$1"
            ;;
        *)
            die "Unknown member action: $action"
            ;;
    esac
}

cmd_file() {
    local action=$1
    shift

    case "$action" in
        pull)
            [ $# -lt 1 ] && die "Remote path required"
            file_pull "${IBMI_PROFILE:-$(get_current_profile)}" "$@"
            ;;
        push)
            [ $# -lt 2 ] && die "Local and remote paths required"
            file_push "${IBMI_PROFILE:-$(get_current_profile)}" "$@"
            ;;
        list)
            file_list "${IBMI_PROFILE:-$(get_current_profile)}" "${1:-.}"
            ;;
        *)
            die "Unknown file action: $action"
            ;;
    esac
}

cmd_folder() {
    local action=$1
    shift

    case "$action" in
        pull)
            [ $# -lt 1 ] && die "Remote path required"
            folder_pull "${IBMI_PROFILE:-$(get_current_profile)}" "$@"
            ;;
        push)
            [ $# -lt 2 ] && die "Local and remote paths required"
            folder_push "${IBMI_PROFILE:-$(get_current_profile)}" "$@"
            ;;
        sync)
            [ $# -lt 2 ] && die "Local and remote paths required"
            folder_sync "${IBMI_PROFILE:-$(get_current_profile)}" "$@"
            ;;
        *)
            die "Unknown folder action: $action"
            ;;
    esac
}

cmd_git() {
    local action=$1
    shift

    case "$action" in
        init)
            git_init "${IBMI_PROFILE:-$(get_current_profile)}"
            ;;
        status)
            git_status "${IBMI_PROFILE:-$(get_current_profile)}"
            ;;
        commit)
            [ $# -lt 1 ] && die "Commit message required"
            git_commit "${IBMI_PROFILE:-$(get_current_profile)}" "$*"
            ;;
        push)
            git_push "${IBMI_PROFILE:-$(get_current_profile)}" "${1:-.}"
            ;;
        pull)
            git_pull "${IBMI_PROFILE:-$(get_current_profile)}" "${1:-.}"
            ;;
        log)
            git_log "${IBMI_PROFILE:-$(get_current_profile)}" "${1:-10}"
            ;;
        diff)
            git_diff "${IBMI_PROFILE:-$(get_current_profile)}" "${1:-.}"
            ;;
        branch)
            git_branch "${IBMI_PROFILE:-$(get_current_profile)}" "$@"
            ;;
        *)
            die "Unknown git action: $action"
            ;;
    esac
}

cmd_session() {
    local action=$1
    shift

    case "$action" in
        start)
            session_init
            session_start "${IBMI_PROFILE:-$(get_current_profile)}"
            ;;
        status)
            session_status "${1:-}"
            ;;
        stop)
            session_stop "${1:-$(get_current_profile)}"
            ;;
        stop-all)
            session_stop_all
            ;;
        set)
            # Parse --library and --srcfile flags
            local library=""
            local srcfile=""
            while [[ $# -gt 0 ]]; do
                case "$1" in
                    --library=*)
                        library="${1#*=}"
                        shift
                        ;;
                    --srcfile=*)
                        srcfile="${1#*=}"
                        shift
                        ;;
                    *)
                        die "Unknown option: $1"
                        ;;
                esac
            done

            if [ -z "$library" ] && [ -z "$srcfile" ]; then
                die "At least one of --library or --srcfile required"
            fi

            session_set_context "${IBMI_PROFILE:-$(get_current_profile)}" "$library" "$srcfile"
            ;;
        show)
            session_show_context "${IBMI_PROFILE:-$(get_current_profile)}"
            ;;
        *)
            die "Unknown session action: $action"
            ;;
    esac
}

cmd_profile() {
    local action=$1
    shift

    case "$action" in
        list)
            config_list_profiles
            ;;
        create)
            config_create_profile
            ;;
        switch)
            [ $# -lt 1 ] && die "Profile name required"
            # Just set IBMI_PROFILE for this session
            IBMI_PROFILE=$1
            print_success "Switched to profile: $1"
            ;;
        edit)
            [ $# -lt 1 ] && die "Profile name required"
            config_edit_profile "$1"
            ;;
        delete)
            [ $# -lt 1 ] && die "Profile name required"
            config_delete_profile "$1"
            ;;
        test)
            [ $# -lt 1 ] && die "Profile name required"
            config_load_profile "$1"
            session_init
            if session_start "$1" 2>&1 | grep -q "successfully"; then
                print_success "Connection test passed"
            else
                print_error "Connection test failed"
                return 1
            fi
            ;;
        *)
            die "Unknown profile action: $action"
            ;;
    esac
}

cmd_config() {
    local action=$1

    case "$action" in
        init)
            config_init
            config_create_default
            ;;
        edit)
            config_edit
            ;;
        show)
            if [ -f "$CONFIG_FILE" ]; then
                cat "$CONFIG_FILE"
            else
                die "Configuration file not found"
            fi
            ;;
        validate)
            config_validate
            print_success "Configuration is valid"
            ;;
        *)
            die "Unknown config action: $action"
            ;;
    esac
}

# ============================================================================
# Main Entry Point
# ============================================================================

main() {
    # Parse global options and get command (BEFORE initializing config)
    parse_global_options "$@"

    # Disable colors if requested
    if [ "${IBMI_NO_COLOR:-0}" = "1" ]; then
        disable_colors
    fi

    # Initialize configuration system
    config_init
    session_init

    # If no arguments, show interactive menu (UI)
    if [ $# -eq 0 ]; then
        print_warning "Interactive menu not yet implemented"
        print_info "Use 'ibmi-sync help' to see available commands"
        return 0
    fi

    # Parse global options again to remove them from positional args
    parse_global_options "$@"

    local command=$1
    shift || true

    case "$command" in
        # Help and version
        help|-h|--help)
            show_help
            ;;
        version|--version|-v)
            show_version
            ;;

        # Commands
        member)
            cmd_member "$@"
            ;;
        file)
            cmd_file "$@"
            ;;
        folder)
            cmd_folder "$@"
            ;;
        git)
            cmd_git "$@"
            ;;
        session)
            cmd_session "$@"
            ;;
        profile)
            cmd_profile "$@"
            ;;
        config)
            cmd_config "$@"
            ;;

        *)
            print_error "Unknown command: $command"

            # Check if user might have meant 'session' command
            if [[ "$command" =~ ^(status|start|stop)$ ]]; then
                print_info "Did you mean: ibmi-sync session $command"
                print_info "Available session actions:"
                echo "  • ibmi-sync session start                 - Start SSH session"
                echo "  • ibmi-sync session status [profile]      - Show session status"
                echo "  • ibmi-sync session stop [profile]        - Stop SSH session"
                echo "  • ibmi-sync session stop-all              - Stop all sessions"
            else
                print_info "Use 'ibmi-sync help' for usage information"
            fi
            return 1
            ;;
    esac
}

# Run main function
main "$@"
exit $?
