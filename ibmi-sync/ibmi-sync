set -o pipefail

# Find the library directory (could be in same location as script or in install prefix)
SCRIPT_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
LIB_DIR="$SCRIPT_DIR/lib"

# If libs aren't in same directory, check install prefix
if [ ! -d "$LIB_DIR" ]; then
    # Check ~/.local/bin/ibmi-sync/lib (standard installation location)
    LIB_DIR="${HOME}/.local/bin/ibmi-sync/lib"
fi

# If still not found, try relative path
if [ ! -d "$LIB_DIR" ]; then
    LIB_DIR="$(dirname "$SCRIPT_DIR")/lib"
fi
VERSION="1.2.1"

# GitHub repository for version checking
GITHUB_REPO="RSA-Data-Solutions/IBMi_Tools"

# Startup version check result is cached here and refreshed at most once a day
VERSION_CACHE_FILE="$HOME/.ibmi/version_check"
VERSION_CHECK_INTERVAL=86400

# Source all libraries
source "$LIB_DIR/common.sh"
source "$LIB_DIR/config.sh"
source "$LIB_DIR/session.sh"
source "$LIB_DIR/members.sh"
source "$LIB_DIR/files.sh"
source "$LIB_DIR/git.sh"

