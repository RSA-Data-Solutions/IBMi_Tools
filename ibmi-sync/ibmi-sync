# ============================================================================

# Version check function
# ============================================================================

# Print the latest release version from GitHub (without the leading "v"), or nothing on failure
fetch_latest_version() {
    local url="https://api.github.com/repos/$GITHUB_REPO/releases/latest"
    local response=""
    if command_exists curl; then
        response=$(curl -s -m 10 "$url")
    elif command_exists wget; then
        response=$(wget -q -T 10 --tries=1 -O- "$url")
    fi
    echo "$response" | grep -o '"tag_name": "[^"]*"' | cut -d'"' -f4 | sed 's/^v//'
}

# Record a check in the cache: "<epoch seconds> <version>" (version empty if the lookup failed)
save_version_cache() {
    echo "$(date +%s) $1" > "$VERSION_CACHE_FILE" 2>/dev/null || true
}

check_for_updates() {
    # Skip version check if debugging or testing
    if [ "${IBMI_DEBUG:-0}" = "1" ]; then
        return 0
    fi

    if ! command_exists curl && ! command_exists wget; then
        return 0
    fi

    # Use the cached result if it is less than a day old
    local now checked_at="" latest_version=""
    now=$(date +%s)
    if [ -f "$VERSION_CACHE_FILE" ]; then
        read -r checked_at latest_version < "$VERSION_CACHE_FILE" || true
    fi
    if ! [[ "$checked_at" =~ ^[0-9]+$ ]] || [ $((now - checked_at)) -ge "$VERSION_CHECK_INTERVAL" ] || [ "$checked_at" -gt "$now" ]; then
        # Failed lookups are cached too, so an offline machine is not delayed on every command
        latest_version=$(fetch_latest_version)
        save_version_cache "$latest_version"
    fi

    # If we got a version and it's different from current
    if [ -n "$latest_version" ] && [ "$latest_version" != "$VERSION" ]; then
        print_warning "A newer version ($latest_version) is available. Use 'ibmi-sync upgrade' to upgrade."
        print_info "To upgrade, run: ibmi-sync upgrade"
    fi
}

# ============================================================================

# Upgrade command function
# ============================================================================

cmd_upgrade() {
    print_info "Checking for updates..."
    
    # Check if we can access the internet
    if ! command_exists curl && ! command_exists wget; then
        die "Neither curl nor wget found. Please install one to check for updates."
    fi
    
    # Get latest version from GitHub (always fresh; refreshes the startup check's cache)
    local latest_version
    latest_version=$(fetch_latest_version)
    save_version_cache "$latest_version"
    
    if [ -z "$latest_version" ]; then
        die "Could not retrieve latest version information from GitHub"
    fi
    
    # Compare versions
    if [ "$latest_version" = "$VERSION" ]; then
        print_success "You are already running the latest version ($VERSION)"
        return 0
    fi
    
    print_info "Latest version is $latest_version, current version is $VERSION"
    
    # Ask for confirmation
    if ! confirm "Upgrade to version $latest_version?"; then
        print_info "Upgrade cancelled"
        return 0
    fi
    
    # Perform the upgrade by downloading and reinstalling
    print_info "Starting upgrade process..."
    
    # Create a temporary directory for download
    local temp_dir=$(mktemp -d)
    local download_url="https://github.com/$GITHUB_REPO/archive/refs/tags/v$latest_version.tar.gz"
    
    # Download the latest release
    print_info "Downloading latest release..."
    if command_exists curl; then
        curl -L -o "$temp_dir/ibmi-tools.tar.gz" "$download_url" || die "Failed to download update"
    elif command_exists wget; then
        wget -O "$temp_dir/ibmi-tools.tar.gz" "$download_url" || die "Failed to download update"
    fi
    
    # Extract the archive
    print_info "Extracting files..."
    tar -xzf "$temp_dir/ibmi-tools.tar.gz" -C "$temp_dir" --strip-components=1 || die "Failed to extract update"
    
    # Run the install script from the downloaded version
    print_info "Installing new version..."
    cd "$temp_dir" || die "Failed to change to temp directory"
    
    # Check if we're in the correct directory
    if [ -f "ibmi-sync/install.sh" ]; then
        cd ibmi-sync
    fi
    
    if [ -f "./install.sh" ]; then
        ./install.sh --no-interactive || die "Installation failed"
        print_success "Upgrade completed successfully to version $latest_version"
    else
        die "Installation script not found in downloaded package"
    fi
    
    # Clean up
    rm -rf "$temp_dir"
    
    print_info "Upgrade complete. Please restart your terminal or run: source ~/.bashrc"
}

show_version() {
    echo "IBM i Unified Sync Tool v$VERSION"
}

# ============================================================================
# Argument Parsing
# ============================================================================

# Parse global options
parse_global_options() {
    while [[ $# -gt 0 ]]; do
        case "$1" in
            --profile=*)
                IBMI_PROFILE="${1#*=}"
                shift
                ;;
            --library=*)
                IBMI_OVERRIDE_LIBRARY="${1#*=}"
                shift
                ;;
            --srcfile=*)
                IBMI_OVERRIDE_SRCFILE="${1#*=}"
                shift
                ;;
            --verbose)
                IBMI_VERBOSE=1
                shift
                ;;
            --quiet)
                IBMI_QUIET=1
                shift
                ;;
            --debug)
                IBMI_DEBUG=1
                shift
                ;;
            --dry-run)
                IBMI_DRY_RUN=1
                shift
                ;;
            --no-color)
                IBMI_NO_COLOR=1
                shift
                ;;
            *)
                break
                ;;
        esac
    done
}

# ============================================================================
# Command Handlers
# ============================================================================

cmd_member() {
    local action=$1
    shift

    case "$action" in
        pull)
            [ $# -lt 1 ] && die "Member name required"
            member_pull "${IBMI_PROFILE:-$(get_current_profile)}" "$1"
            ;;
        push)
            [ $# -lt 1 ] && die "Member name required"
            member_push "${IBMI_PROFILE:-$(get_current_profile)}" "$1"
            ;;
        sync)
            [ $# -lt 1 ] && die "Member name required"
            member_sync "${IBMI_PROFILE:-$(get_current_profile)}" "$1"
            ;;
        compile)
            [ $# -lt 1 ] && die "Member name required"
            member_compile "${IBMI_PROFILE:-$(get_current_profile)}" "$1"
            ;;
        create)
            [ $# -lt 1 ] && die "Member name required"
            member_create "${IBMI_PROFILE:-$(get_current_profile)}" "$1" "${2:-}"  # empty: detect from the local file
            ;;
        create-batch)
            [ $# -lt 3 ] && die "Need at least srcfile, srctype, and one member"
            member_create_batch "${IBMI_PROFILE:-$(get_current_profile)}" "$1" "$2" "${@:3}"
            ;;
        list)
            member_list "${IBMI_PROFILE:-$(get_current_profile)}"
            ;;
        pull-all)
            member_pull_all "${IBMI_PROFILE:-$(get_current_profile)}"
            ;;
        info)
            [ $# -lt 1 ] && die "Member name required"
            member_info "${IBMI_PROFILE:-$(get_current_profile)}" "$1"
            ;;
        search)
            [ $# -lt 1 ] && die "Search pattern required"
            member_search "${IBMI_PROFILE:-$(get_current_profile)}" "$1"
            ;;
        compare)
            [ $# -lt 1 ] && die "Member name required"
            member_compare "${IBMI_PROFILE:-$(get_current_profile)}" "$1"
            ;;
        delete)
            [ $# -lt 1 ] && die "Member name required"
            member_delete "${IBMI_PROFILE:-$(get_current_profile)}" "$1"
            ;;
        *)
            die "Unknown member action: $action"
            ;;
    esac
}

cmd_file() {
    local action=$1
    shift

    case "$action" in
        pull)
            [ $# -lt 1 ] && die "Remote path required"
            file_pull "${IBMI_PROFILE:-$(get_current_profile)}" "$@"
            ;;
        push)
            [ $# -lt 2 ] && die "Local and remote paths required"
            file_push "${IBMI_PROFILE:-$(get_current_profile)}" "$@"
            ;;
        list)
            file_list "${IBMI_PROFILE:-$(get_current_profile)}" "${1:-.}"
            ;;
        *)
            die "Unknown file action: $action"
            ;;
    esac
}

cmd_folder() {
    local action=$1
    shift

    case "$action" in
        pull)
            [ $# -lt 1 ] && die "Remote path required"
            folder_pull "${IBMI_PROFILE:-$(get_current_profile)}" "$@"
            ;;
        push)
            [ $# -lt 2 ] && die "Local and remote paths required"
            folder_push "${IBMI_PROFILE:-$(get_current_profile)}" "$@"
            ;;
        sync)
            [ $# -lt 2 ] && die "Local and remote paths required"
            folder_sync "${IBMI_PROFILE:-$(get_current_profile)}" "$@"
            ;;
        *)
            die "Unknown folder action: $action"
            ;;
    esac
}

cmd_git() {
    local action=$1
    shift

    case "$action" in
        init)
            git_init "${IBMI_PROFILE:-$(get_current_profile)}"
            ;;
        status)
            git_status "${IBMI_PROFILE:-$(get_current_profile)}"
            ;;
        commit)
            [ $# -lt 1 ] && die "Commit message required"
            git_commit "${IBMI_PROFILE:-$(get_current_profile)}" "$*"
            ;;
        push)
            git_push "${IBMI_PROFILE:-$(get_current_profile)}" "${1:-.}"
            ;;
        pull)
            git_pull "${IBMI_PROFILE:-$(get_current_profile)}" "${1:-.}"
            ;;
        log)
            git_log "${IBMI_PROFILE:-$(get_current_profile)}" "${1:-10}"
            ;;
        diff)
            git_diff "${IBMI_PROFILE:-$(get_current_profile)}" "${1:-.}"
            ;;
        branch)
            git_branch "${IBMI_PROFILE:-$(get_current_profile)}" "$@"
            ;;
        *)
            die "Unknown git action: $action"
            ;;
    esac
}

cmd_session() {
    local action=$1
    shift

    case "$action" in
        start)
            session_init
            session_start "${IBMI_PROFILE:-$(get_current_profile)}"
            ;;
        status)
            session_status "${1:-}"
            ;;
        stop)
            session_stop "${1:-$(get_current_profile)}"
            ;;
        stop-all)
            session_stop_all
            ;;
        set)
            # Parse --library and --srcfile flags
            local library=""
            local srcfile=""
            while [[ $# -gt 0 ]]; do
                case "$1" in
                    --library=*)
                        library="${1#*=}"
                        shift
                        ;;
                    --srcfile=*)
                        srcfile="${1#*=}"
                        shift
                        ;;
                    *)
                        die "Unknown option: $1"
                        ;;
                esac
            done

            if [ -z "$library" ] && [ -z "$srcfile" ]; then
                die "At least one of --library or --srcfile required"
            fi

            session_set_context "${IBMI_PROFILE:-$(get_current_profile)}" "$library" "$srcfile"
            ;;
        show)
            session_show_context "${IBMI_PROFILE:-$(get_current_profile)}"
            ;;
        *)
            die "Unknown session action: $action"
            ;;
    esac
}

cmd_profile() {
    local action=$1
    shift

    case "$action" in
        list)
            config_list_profiles
            ;;
        create)
            config_create_profile
            ;;
        switch)
            [ $# -lt 1 ] && die "Profile name required"
            # Just set IBMI_PROFILE for this session
            IBMI_PROFILE=$1
            print_success "Switched to profile: $1"
            ;;
        edit)
            [ $# -lt 1 ] && die "Profile name required"
            config_edit_profile "$1"
            ;;
        delete)
            [ $# -lt 1 ] && die "Profile name required"
            config_delete_profile "$1"
            ;;
        test)
            [ $# -lt 1 ] && die "Profile name required"
            config_load_profile "$1"
            session_init
            if session_start "$1" 2>&1 | grep -q "successfully"; then
                print_success "Connection test passed"
            else
                print_error "Connection test failed"
                return 1
            fi
            ;;
        *)
            die "Unknown profile action: $action"
            ;;
    esac
}

cmd_config() {
    local action=$1

    case "$action" in
        init)
            config_init
            config_create_default
            ;;
        edit)
            config_edit
            ;;
        show)
            if [ -f "$CONFIG_FILE" ]; then
                cat "$CONFIG_FILE"
            else
                die "Configuration file not found"
            fi
            ;;
        validate)
            config_validate
            print_success "Configuration is valid"
            ;;
        *)
            die "Unknown config action: $action"
            ;;
    esac
}

# ============================================================================
# Main Entry Point
# ============================================================================

main() {
    # Parse global options and get command (BEFORE initializing config)
    parse_global_options "$@"
    
    # Disable colors if requested
    if [ "${IBMI_NO_COLOR:-0}" = "1" ]; then
        disable_colors
    fi
    
    # Initialize configuration system
    config_init
    session_init
    
    # Check for updates when session starts (but not in debug mode)
    check_for_updates
    
    # If no arguments, show interactive menu (UI)
    if [ $# -eq 0 ]; then
        print_warning "Interactive menu not yet implemented"
        print_info "Use 'ibmi-sync help' to see available commands"
        return 0
    fi

    # Parse global options again to remove them from positional args
    parse_global_options "$@"

    local command=$1
    shift || true

    case "$command" in
        # Help and version
        help|-h|--help)
            show_help
            ;;
        version|--version|-v)
            show_version
            ;;

        # Commands
        member)
            cmd_member "$@"
            ;;
        file)
            cmd_file "$@"
            ;;
        folder)
            cmd_folder "$@"
            ;;
        git)
            cmd_git "$@"
            ;;
        session)
            cmd_session "$@"
            ;;
        profile)
            cmd_profile "$@"
            ;;
        config)
            cmd_config "$@"
            ;;
        upgrade)
            cmd_upgrade
            ;;

        *)
            print_error "Unknown command: $command"

            # Check if user might have meant 'session' command
            if [[ "$command" =~ ^(status|start|stop)$ ]]; then
                print_info "Did you mean: ibmi-sync session $command"
                print_info "Available session actions:"
                echo "  • ibmi-sync session start                 - Start SSH session"
                echo "  • ibmi-sync session status [profile]      - Show session status"
                echo "  • ibmi-sync session stop [profile]        - Stop SSH session"
                echo "  • ibmi-sync session stop-all              - Stop all sessions"
            else
                print_info "Use 'ibmi-sync help' for usage information"
            fi
            return 1
            ;;
    esac
}

# Run main function
main "$@"
exit $?
